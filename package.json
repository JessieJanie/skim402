{
  "name": "mastra-skim",
  "version": "0.1.3",
  "description": "Mastra tool for Skim (skim402.com) — clean web reader for AI agents. Fetch any URL as agent-ready Markdown. Card plan API key (free tier at skim402.com/pricing) or pay-per-call via x402 USDC wallet.",
  "type": "module",
